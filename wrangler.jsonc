{
  "name": "the-loft",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain purchased in Cloudflare for this site.
  "routes": [
    { "pattern": "ballard.place", "custom_domain": true },
    { "pattern": "www.ballard.place", "custom_domain": true }
  ],
  // Production namespace: the-loft-bookings.
  // preview_id matches production until a separate preview namespace exists.
  "kv_namespaces": [
    {
      "binding": "BOOKINGS",
      "id": "44c5f865914847c189511787becebf14",
      "preview_id": "44c5f865914847c189511787becebf14"
    }
  ],
  // Non-secret defaults for deploy. Prefer `wrangler secret` / dashboard secrets
  // if you rotate calendar tokens.
  "vars": {
    "SITE_URL": "https://ballard.place",
    "NIGHTLY_RATE": "185",
    "VENMO_USERNAME": "mattbowers",
    "VENMO_PAYMENT_LINK": "https://venmo.com/mattbowers",
    "AIRBNB_ICAL_URL": "https://www.airbnb.com/calendar/ical/1703090109214600082.ics?t=c709945b79284ed593daea02e0eb1b16",
    "VRBO_ICAL_URL": "https://www.vrbo.com/icalendar/27acb58d007d4c65a55fa08b70748946.ics?nonTentative"
  }
}
