---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Loft — Ballard vacation rental",
  description = "Two-level Ballard loft in Seattle. Pick dates synced from Airbnb & VRBO, pay with Venmo.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ballard.place/" />
    <meta property="og:url" content="https://ballard.place/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#book">Skip to booking</a>
    <slot />
  </body>
</html>
